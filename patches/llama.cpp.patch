+++ b/src/llama-context.cpp
@@ -183,6 +183,14 @@ llama_context::llama_context(
     }
 
     cparams.n_rs_seq = params.n_rs_seq;
+    // npurun: keep a 1-token recurrent rollback window by default (override with
+    // LLAMA_N_RS_SEQ=n, 0 disables). For qwen35 this enables the rows-mode GDN
+    // path, which reads/writes each layer's state in place instead of gathering
+    // and copying it back every token: identical output, much less memory traffic.
+    if (cparams.n_rs_seq == 0) {
+        const char * e = getenv("LLAMA_N_RS_SEQ");
+        cparams.n_rs_seq = e ? (uint32_t) std::max(0, atoi(e)) : (llm_arch_supports_rs_rollback(model.arch) ? 1u : 0u);
+    }
     if (cparams.n_rs_seq > 0 && !llm_arch_supports_rs_rollback(model.arch)) {
         LLAMA_LOG_DEBUG("%s: n_rs_seq=%u requested but model does not support recurrent partial rollback; clamping to 0\n",
                         __func__, cparams.n_rs_seq);
